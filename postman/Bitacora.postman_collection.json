            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Incluye foto\", () => pm.expect(pm.response.json().fotoBase64).to.eql(\"aG9sYQ==\"));"
            ]
