              "pm.test(\"HTTP 500\", () => pm.response.to.have.status(500));",
              "pm.test(\"ProblemDetails sin detalle interno\", () => { const r = pm.response.json(); pm.expect(r.status).to.eql(500); pm.expect(r).to.have.property(\"traceId\"); pm.expect(JSON.stringify(r)).not.to.include(\"InvalidOperationException\"); pm.expect(JSON.stringify(r)).not.to.include(\"Fallo de prueba controlado\"); });"
