{
  "info": {
    "name": "Bitácora — Tarea 2.2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contrato: controladores y DTO de backend; OpenAPI exportado en backend/openapi.json. Ejecutar en orden contra base de pruebas. Login de laboratorio solo Development; suministrar username y password desde entorno privado no versionado. No guardar accessToken real en el archivo exportado."
  },
  "variable": [
    {
      "key": "registroId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login de laboratorio",
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear registro válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/registros",
        "body": {
          "mode": "raw",
          "raw": "{\"titulo\": \"Registro de campo\", \"descripcion\": \"Observaci\\u00f3n de prueba\", \"fotoBase64\": \"aG9sYQ==\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json(); pm.collectionVariables.set(\"registroId\", r.id);",
              "pm.test(\"Location apunta al recurso\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/registros/\" + r.id));",
              "pm.test(\"Fecha del servidor\", () => pm.expect(Date.parse(r.fechaCreacion)).to.be.a(\"number\").and.not.NaN);"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar sin fotografías",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/registros"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Arreglo de registros sin foto\", () => { const rows = pm.response.json(); pm.expect(rows).to.be.an(\"array\"); rows.forEach(r => pm.expect(r).not.to.have.property(\"fotoBase64\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Listado con formato no admitido",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/xml"
